MCP_HOST=127.0.0.1
MCP_PORT=8787

# Optional AWS Bedrock inference. Without these settings, MCP extraction uses
# Relay's local, deterministic heuristic and does not call AWS.
# RELAY_EXTRACTION_PROVIDER=bedrock
# AWS_PROFILE=relay-dev
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-enabled-bedrock-model-id
